#!/usr/bin/env bash
# bd-stub — PATH/BD_PATH-injectable stand-in for the real `bd` binary, used by
# test/hub-replay.test.mjs to pin the WS hub's replay-on-reconnect behavior
# (aperture-xt16e) without touching hub code or a real BEADS store.
#
# Contract (mirrors mcp-server/src/beads.ts getUnreadMessages and bd 1.0.2
#           list semantics: complete message-wisp selection, then sort, stdout bounded
#           by the caller rather than a pre-sort row limit):
#   bd list --type message --status open --title-contains '->RECIPIENT]' --include-infra \
#     --sort id --reverse --json -n 0
#     → prints the JSON array in $BD_STUB_DIR/unread-RECIPIENT.json, or [] if
#       that file is absent.
#
# Behavior knobs (env):
#   BD_STUB_DIR   (required) — seed-file dir; also receives bd-calls.log, one
#                  line per invocation with the full argv joined by tabs
#                  (evidence + call-count assertions).
#   BD_STUB_FAIL=1 — exit 1 with stderr after logging the call (pins the hub's
#                  replay_error / connection-survives path).
#
# ANY argv shape other than the getUnreadMessages query above exits 2 with a
# loud stderr message. This is deliberate: if beads.ts ever changes the query
# shape (contract drift), the replay tests fail instead of silently passing
# against a stub that no longer models reality.

set -u

if [[ -z "${BD_STUB_DIR:-}" ]]; then
  echo "bd-stub: BD_STUB_DIR is not set — this stub must only run under hub-replay.test.mjs" >&2
  exit 2
fi

# Evidence log: full argv, tab-separated, one line per invocation.
argv_line=""
for arg in "$@"; do
  argv_line+="${arg}"$'\t'
done
printf '%s\n' "${argv_line%$'\t'}" >> "$BD_STUB_DIR/bd-calls.log"

if [[ "${BD_STUB_FAIL:-}" == "1" ]]; then
  echo "bd-stub: simulated bd failure (BD_STUB_FAIL=1)" >&2
  exit 1
fi

# Read-time authorization loss annotates the original open row instead of
# closing/replacing it. Accept that one mutation shape so replay tests can pin
# the durable-withheld contract without a real BEADS store.
if [[ $# -eq 5 && "$1" == "update" && "$3" == "--add-label" && "$5" == "--json" && "$4" == withheld:* ]]; then
  printf '{"id":"%s","status":"open","labels":["%s"]}\n' "$2" "$4"
  exit 0
fi

# The primary recognized shape: complete getUnreadMessages list scan.
if [[ $# -eq 14 && "$1" == "list" && "$2" == "--type" && "$3" == "message" && "$4" == "--status" && "$5" == "open" && "$6" == "--title-contains" && "$8" == "--include-infra" && "$9" == "--sort" && "${10}" == "id" && "${11}" == "--reverse" && "${12}" == "--json" && "${13}" == "-n" && "${14}" == "0" ]]; then
  title_filter="$7"
  re='^->([^]]+)\]$'
  if [[ "$title_filter" =~ $re ]]; then
    recipient="${BASH_REMATCH[1]}"
    seed="$BD_STUB_DIR/unread-${recipient}.json"
    if [[ -f "$seed" ]]; then
      node - "$seed" "$title_filter" <<'NODE'
const fs = require("node:fs");
const rows = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const titleFilter = process.argv[3].toLowerCase();
const page = rows
  .filter((row) => row.issue_type === "message" && row.status === "open" && String(row.title ?? "").toLowerCase().includes(titleFilter))
  .sort((a, b) => b.id.localeCompare(a.id));
process.stdout.write(JSON.stringify(page));
NODE
    else
      echo "[]"
    fi
    exit 0
  fi
fi

echo "bd-stub: unrecognized argv shape (contract drift from beads.ts unread/withheld contract?): $*" >&2
exit 2
