{
  "mcpServers": {
    "aperture-bus": {
      "command": "/Users/franciscomateus/projects/aperture/mcp-server/start.sh"
    },
    "mempalace": {
      "command": "/Users/franciscomateus/.mempalace/venv/bin/python",
      "args": [
        "-m",
        "mempalace.mcp_server",
        "--palace",
        "/Users/franciscomateus/.aperture/mempalace"
      ]
    },
    "playwright-mini": {
      "command": "/Users/franciscomateus/projects/aperture/scripts/playwright-mcp-mini.sh"
    }
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/franciscomateus/projects/aperture/mcp-server/dist/presence-hint.js busy",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/franciscomateus/projects/aperture/mcp-server/dist/presence-hint.js busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/franciscomateus/projects/aperture/mcp-server/dist/presence-hint.js idle",
            "timeout": 5
          }
        ]
      }
    ]
  }
